<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Libreria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Libreria.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-fill"></i> Librería
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var rol = Context.Session.GetString("rol")?.ToLower();
                        }
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        @if (!string.IsNullOrEmpty(rol))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Pagos" asp-action="Create">
                                    <i class="bi bi-cash-coin"></i> Registrar Pago
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(rol) && rol == "admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill"></i> Administración
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                            <i class="bi bi-people"></i> Usuarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="TipoGasto" asp-action="Index">
                                            <i class="bi bi-tags"></i> Tipos de Gasto
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(rol) && rol == "gerente")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="gerenteDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill"></i> Administración
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="gerenteDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Pagos" asp-action="Index">
                                            <i class="bi bi-list-check"></i> Ver Todos los Pagos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                            <i class="bi bi-people"></i> Usuarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="UsuariosPorMonto">
                                            <i class="bi bi-currency-dollar"></i> Usuarios por Monto
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (string.IsNullOrEmpty(rol))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Login" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Usuarios" asp-action="Create">
                                    <i class="bi bi-person-plus"></i> Registrar
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-white me-3">
                                    <i class="bi bi-person-circle"></i>
                                    @Context.Session.GetString("nombre") (@rol)
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-white p-0">
                                        <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-3">
        <partial name="_Alerts" />
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Librería - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>