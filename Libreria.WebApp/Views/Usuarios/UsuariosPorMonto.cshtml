@model Libreria.WebApp.Models.UsuariosPorMontoViewModel
@{
    ViewData["Title"] = "Usuarios por Monto";
}
<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-currency-dollar"></i> Usuarios por Monto de Pagos
            </h3>
        </div>
        <div class="card-body">
            <form method="get" asp-action="UsuariosPorMonto" class="row g-3 mb-4">
                <div class="col-md-8">
                    <label for="monto" class="form-label">Monto</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number"
                               name="monto"
                               id="monto"
                               class="form-control"
                               value="@Model.Monto"
                               min="0"
                               step="0.01"
                               placeholder="Ingrese el monto"
                               required />
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>
            <hr />
            @if (Model.Monto.HasValue)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Mostrando usuarios con pagos totales superiores a <strong>$@Model.Monto.Value.ToString("N2")</strong>
                </div>

                @if (Model.Usuarios != null && Model.Usuarios.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>Email</th>
                                    <th>Monto Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model.Usuarios)
                                {
                                    <tr>
                                        <td>@usuario.Id</td>
                                        <td>@usuario.Nombre</td>
                                        <td>@usuario.Apellido</td>
                                        <td>@usuario.Email</td>
                                        <td>
                                            <span class="badge bg-success fs-6">
                                                $@usuario.MontoTotal.ToString("N2")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle"></i>
                        Se encontraron <strong>@Model.Usuarios.Count()</strong> usuario(s)
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        No se encontraron usuarios con pagos totales superiores a <strong>$@Model.Monto.Value.ToString("N2")</strong>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary text-center">
                    <i class="bi bi-arrow-up-circle"></i>
                    Ingrese un monto para buscar usuarios
                </div>
            }
        </div>
    </div>
</div>