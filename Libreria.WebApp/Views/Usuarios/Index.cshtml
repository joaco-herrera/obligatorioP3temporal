@model IEnumerable<Libreria.LogicaAplicacion.Dtos.Usuarios.UsuarioDtoListado>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-black mb-0"><i class="bi bi-people"></i> Lista de Usuarios</h2>
        <a asp-controller="Usuarios" asp-action="Registrar" class="btn btn-dark">
            <i class="bi bi-plus-circle"></i> Nuevo Usuario
        </a>
    </div>
    <table class="table table-bordered table-hover align-middle bg-white">
        <thead class="table-light">
            <tr>
                <th class="text-center">ID</th>
                <th class="text-center">Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Equipo</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Id</td>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Apellido</td>
                    <td>@usuario.Email</td>
                    <td>
                        @if (usuario.Rol == "Admin")
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else if (usuario.Rol == "Gerente")
                        {
                            <span class="badge bg-warning text-dark">Gerente</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Empleado</span>
                        }
                    </td>
                    <td>
                        @if (usuario.NombreEquipo == "Desarrollo")
                        {
                            <span class="badge bg-primary">@usuario.NombreEquipo</span>
                        }
                        else if (usuario.NombreEquipo == "Gerencia")
                        {
                            <span class="badge bg-warning text-dark">@usuario.NombreEquipo</span>
                        }
                        else if (usuario.NombreEquipo == "Sin Equipo")
                        {
                            <span class="badge bg-secondary">@usuario.NombreEquipo</span>
                        }
                        else
                        {
                            <span class="badge bg-dark">@usuario.NombreEquipo</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-info me-1">
                            <i class="bi bi-eye"></i> Ver
                        </a>
                        <a asp-action="Delete" asp-route-id="@usuario.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('¿Está seguro que desea eliminar este usuario?');">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>