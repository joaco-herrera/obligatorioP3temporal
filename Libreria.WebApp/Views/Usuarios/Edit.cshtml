@model Libreria.LogicaAplicacion.Dtos.Usuarios.UsuarioDtoListado
@{
    ViewData["Title"] = "Editar Usuario";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil"></i> Editar Usuario</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Apellido" class="form-label fw-bold"></label>
                            <input asp-for="Apellido" class="form-control" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" readonly />
                            <small class="text-muted">El email se genera automáticamente y no puede ser modificado</small>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label fw-bold">Rol</label>
                            <select asp-for="Rol" class="form-control">
                                <option value="Empleado">Empleado</option>
                                <option value="Gerente">Gerente</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label for="equipoId" class="form-label fw-bold">Equipo</label>
                            <select name="equipoId" id="equipoId" class="form-select">
                                @if (ViewBag.Equipos != null)
                                {
                                    @foreach (var equipo in ViewBag.Equipos)
                                    {
                                        <option value="@equipo.Id" selected="@(Model.EquipoId == equipo.Id)">@equipo.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-check-circle"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>