@model Libreria.LogicaAplicacion.Dtos.Usuarios.UsuarioDtoListado
@{
    ViewData["Title"] = "Detalles del Usuario";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-person-lines-fill"></i> Detalles del Usuario</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">Nombre</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>
                        <dt class="col-sm-4 fw-bold">Apellido</dt>
                        <dd class="col-sm-8">@Model.Apellido</dd>
                        <dt class="col-sm-4 fw-bold">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                        <dt class="col-sm-4 fw-bold">Rol</dt>
                        <dd class="col-sm-8">
                            @if (Model.Rol == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (Model.Rol == "Gerente")
                            {
                                <span class="badge bg-warning text-dark">Gerente</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Empleado</span>
                            }
                        </dd>
                        <dt class="col-sm-4 fw-bold">Equipo</dt>
                        <dd class="col-sm-8">
                            @if (Model.NombreEquipo == "Desarrollo")
                            {
                                <span class="badge bg-primary">@Model.NombreEquipo</span>
                            }
                            else if (Model.NombreEquipo == "Gerencia")
                            {
                                <span class="badge bg-warning text-dark">@Model.NombreEquipo</span>
                            }
                            else if (Model.NombreEquipo == "Sin Equipo")
                            {
                                <span class="badge bg-secondary">@Model.NombreEquipo</span>
                            }
                            else
                            {
                                <span class="badge bg-dark">@Model.NombreEquipo</span>
                            }
                        </dd>
                    </dl>
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>