@model Libreria.LogicaAplicacion.Dtos.TipoGasto.TipoGastoDtoListado
@{
    ViewData["Title"] = "Editar tipo de gasto";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil"></i> Editar tipo de gasto</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-info">@ViewBag.Message</div>
                    }
                    <form asp-action="Edit" method="post">                     
                        <div class="mb-3">
                            <label for="Nombre" class="form-label fw-bold">Nombre</label>
                            <input name="Nombre" value="@Model.Nombre" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="Descripcion" class="form-label fw-bold">Descripción</label>
                            <input name="Descripcion" value="@Model.Descripcion" class="form-control" />
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-check-circle"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>